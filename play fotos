import { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { motion } from "framer-motion";
import { useRouter } from "next/router";

export default function HomeScreen() {
  const [whatsapp, setWhatsapp] = useState("");
  const [validationError, setValidationError] = useState("");
  const router = useRouter();

  const validateWhatsapp = (number) => {
    const regex = /^\(?\d{2}\)?\s?\d{4,5}-?\d{4}$/; // Flexible regex for WhatsApp numbers
    return regex.test(number);
  };

  const handleLogin = () => {
    if (!validateWhatsapp(whatsapp)) {
      setValidationError("Número de WhatsApp inválido! Tente no formato (99) 99999-9999.");
      return;
    }
    setValidationError("");
    localStorage.setItem("whatsapp", whatsapp);
    router.push("/eventos");
  };

  return (
    <main className="flex flex-col items-center justify-center min-h-screen p-4 bg-gray-100">
      <motion.div
        initial={{ opacity: 0, y: 30 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.6 }}
        className="w-full max-w-md"
      >
        <Card className="rounded-2xl shadow-lg">
          <CardContent className="p-6 space-y-6">
            <h1 className="text-2xl font-bold text-center text-gray-800">
              Bem-vindo ao PhotoPlay 📸
            </h1>
            <p className="text-gray-600 text-center">
              Entre com seu número do WhatsApp para visualizar suas fotos esportivas.
            </p>
            <Input
              placeholder="(99) 99999-9999"
              value={whatsapp}
              onChange={(e) => setWhatsapp(e.target.value)}
              className={`text-center ${validationError ? "border-red-500" : ""}`}
            />
            {validationError && <p className="text-red-500 mt-2">{validationError}</p>}
            <Button
              onClick={handleLogin}
              className="w-full bg-green-500 hover:bg-green-600 text-white flex items-center justify-center"
            >
              <span className="mr-2">📲</span> Entrar com WhatsApp
            </Button>
          </CardContent>
        </Card>
      </motion.div>
    </main>
  );
}

export function EventosScreen() {
