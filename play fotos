export function GaleriaFotos({ eventoId }) {
  const fotos = [
    { id: 1, url: "/fotos/foto1.jpg" },
    { id: 2, url: "/fotos/foto2.jpg" },
    { id: 3, url: "/fotos/foto3.jpg" },
  ];

  const [selecionadas, setSelecionadas] = useState([]);

  const toggleSelecionar = (id) => {
    setSelecionadas((prev) =>
      prev.includes(id) ? prev.filter((fotoId) => fotoId !== id) : [...prev, id]
    );
  };

  const handleComprar = async () => {
    const stripe = await stripePromise;
    const whatsapp = localStorage.getItem("whatsapp");
    const response = await fetch("/api/checkout", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ fotos: selecionadas, whatsapp }),
    });

    const session = await response.json();

    if (session.id) {
      const result = await stripe.redirectToCheckout({
        sessionId: session.id,
      });

      if (result.error) {
        alert(result.error.message);
      }
    } else {
      alert("Erro ao iniciar checkout. Tente novamente mais tarde.");
    }
  };

  return (
    <main className="min-h-screen p-4 bg-gray-100">
      <h2 className="text-2xl font-bold text-gray-800 mb-4">Fotos do Evento #{eventoId}</h2>
      <div className="grid grid-cols-2 gap-4">
        {fotos.map((foto) => (
          <div
            key={foto.id}
            onClick={() => toggleSelecionar(foto.id)}
            className={`relative cursor-pointer rounded-lg overflow-hidden border-4 ${
              selecionadas.includes(foto.id) ? "border-green-500" : "border-transparent"
            }`}
          >
            <img
              src={foto.url}
              alt={`Foto ${foto.id}`}
              className="w-full h-40 object-cover opacity-70"
            />
            <div className="absolute inset-0 flex items-center justify-center">
              {selecionadas.includes(foto.id) && (
                <span className="text-white font-bold text-xl">✓</span>
              )}
            </div>
          </div>
        ))}
      </div>
      <Button
        onClick={handleComprar}
        className="mt-6 w-full bg-green-600 hover:bg-green-700 text-white"
      >
        Comprar Fotos Selecionadas
      </Button>
    </main>
  );
}

export function PagamentoSucesso() {
  const router = useRouter();
  const [enviando, setEnviando] = useState(true);

  useEffect(() => {
    const enviarWhatsApp = async () => {
      const sessionId = router.query.session_id;
      const whatsapp = localStorage.getItem("whatsapp");

      if (sessionId && whatsapp) {
        try {
          await fetch("/api/enviar-fotos", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ sessionId, whatsapp }),
          });
        } catch (error) {
          console.error("Erro ao enviar fotos via WhatsApp:", error);
        }

        setEnviando(false);
      }
    };

    enviarWhatsApp();
  }, [router.query.session_id]);

  return (
    <main className="flex flex-col items-center justify-center min-h-screen bg-white text-center px-4">
      {enviando ? (
        <h1 className="text-xl font-semibold text-gray-800">Processando pagamento e enviando suas fotos pelo WhatsApp...</h1>
      ) : (
        <>
          <h1 className="text-2xl font-bold text-green-700">Pagamento confirmado! ✅</h1>
          <p className="text-gray-700 mt-4">Suas fotos já foram enviadas para seu WhatsApp. Obrigado por comprar conosco!</p>
        </>
      )}
    </main>
  );
}
